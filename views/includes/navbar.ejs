<nav class="navbar navbar-expand-lg fixed-top custom-navbar">
  <div class="container-xl">
    <!-- Brand Logo -->
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <span>Mentor<span class="text-gradient">Meter</span></span>
    </a>

    <!-- Mobile Toggler -->
    <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
      aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-2 text-dark"></i>
    </button>

    <!-- Navbar Content -->
    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Left Links -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
        <li class="nav-item ms-lg-3">
          <a href="/professors" class="nav-link-modern">
            <i class="bi bi-grid-fill me-1 text-primary"></i> Explore Faculty
          </a>
        </li>
      </ul>

      <!-- Center Live Search Bar -->
      <div class="search-wrapper mx-lg-4 my-2 my-lg-0" style="max-width: 440px;">
        <form action="/professors" method="GET" role="search" id="prof-search-form" class="m-0">
          <i class="bi bi-search search-icon-left"></i>
          <input 
            type="text" 
            name="q" 
            id="liveSearchInput"
            class="search-box-modern" 
            placeholder="Search by professor name or department..."
            value="<%= typeof query !== 'undefined' ? query : '' %>"
            autocomplete="off"
          >
          <span class="search-kbd-badge d-none d-md-inline-block">/</span>
        </form>

        <!-- Live Search Dropdown -->
        <div id="liveSearchResults" class="live-search-results"></div>
      </div>

      <!-- Right Side Actions -->
      <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-2 mt-lg-0">
        <% if (currentUser && currentUser.isAdmin) { %>
          <li class="nav-item">
            <a href="/professors/new" class="btn-primary-modern btn-pill py-2 px-3 text-nowrap">
              <i class="bi bi-plus-circle-fill"></i> Add Professor
            </a>
          </li>
        <% } %>

        <% if (currentUser) { %>
          <li class="nav-item">
            <a href="https://docs.google.com/forms/d/e/1FAIpQLSe0xA8IjPMI1prjbXtJGj6nFVsuQ8FQFImkJCQhpssxd8dYvw/viewform?usp=dialog" 
               target="_blank" 
               rel="noopener noreferrer"
               class="btn-outline-modern btn-pill py-2 px-3 text-nowrap"
               title="Request new professor to be added">
              <i class="bi bi-person-plus"></i> Request
            </a>
          </li>

          <li class="nav-item dropdown">
            <div class="user-pill dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="user-avatar-sm">
                <%= (currentUser.username && currentUser.username[0]) ? currentUser.username[0].toUpperCase() : 'U' %>
              </div>
              <span class="text-truncate" style="max-width: 120px;"><%= currentUser.username %></span>
              <% if (currentUser.isAdmin) { %>
                <span class="badge bg-primary text-white" style="font-size: 0.65rem;">Admin</span>
              <% } %>
            </div>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2">
              <li class="px-3 py-2 border-bottom mb-1">
                <small class="text-muted d-block">Signed in as</small>
                <strong><%= currentUser.username %></strong>
              </li>
              <li>
                <a href="/professors" class="dropdown-item rounded-3 py-2">
                  <i class="bi bi-search me-2 text-primary"></i> Browse Professors
                </a>
              </li>
              <% if (currentUser.isAdmin) { %>
                <li>
                  <a href="/professors/new" class="dropdown-item rounded-3 py-2">
                    <i class="bi bi-plus-circle me-2 text-primary"></i> Add Professor
                  </a>
                </li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a href="/logout" class="dropdown-item rounded-3 py-2 text-danger">
                  <i class="bi bi-box-arrow-right me-2"></i> Log Out
                </a>
              </li>
            </ul>
          </li>

        <% } else { %>
          <li class="nav-item">
            <a href="/login" class="btn-outline-modern btn-pill py-2 px-3">
              <i class="bi bi-box-arrow-in-right me-1"></i> Log In
            </a>
          </li>
          <li class="nav-item">
            <a href="/signup" class="btn-gradient-modern btn-pill py-2 px-3">
