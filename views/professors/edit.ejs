<% layout('layouts/boilerplate') %>

<div class="container-xl py-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/professors" class="text-decoration-none">Faculty</a></li>
      <li class="breadcrumb-item"><a href="/professors/<%= professor._id %>" class="text-decoration-none"><%= professor.name %></a></li>
      <li class="breadcrumb-item active" aria-current="page">Edit Profile</li>
    </ol>
  </nav>

  <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5 mx-auto bg-white" style="max-width: 720px;">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
      <div class="rounded-circle bg-warning-subtle text-warning-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
        <i class="bi bi-pencil-square fs-5"></i>
      </div>
      <div>
        <h3 class="fw-bold text-dark mb-0">Edit Faculty Profile</h3>
        <small class="text-muted">Update details, research summary, or photo for <%= professor.name %></small>
      </div>
    </div>

    <form action="/professors/<%= professor._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
      <!-- Professor Name -->
      <div class="mb-4">
        <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
          <input type="text" id="name" name="professor[name]" value="<%= professor.name %>" class="form-control border-start-0 ps-0" required>
        </div>
      </div>

      <!-- Department -->
      <div class="mb-4">
        <label for="department" class="form-label">Department <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-building"></i></span>
          <input type="text" id="department" name="professor[department]" value="<%= professor.department %>" class="form-control border-start-0 ps-0" required>
        </div>
      </div>

      <!-- University -->
      <div class="mb-4">
        <label class="form-label">University / Institution</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
          <input type="text" class="form-control border-start-0 ps-0 bg-light" value="Delhi Technological University" disabled>
        </div>
        <input type="hidden" name="professor[university]" value="Delhi Technological University">
      </div>

      <!-- Description -->
      <div class="mb-4">
        <label for="description" class="form-label">Bio & Research Areas</label>
        <textarea id="description" name="professor[description]" class="form-control" rows="4"><%= professor.description || "" %></textarea>
      </div>

      <!-- Photo Update with Preview -->
      <div class="mb-4">
        <label class="form-label">Update Profile Photo (Optional)</label>
        <div class="upload-dropzone" onclick="document.getElementById('editImageInput').click()">
          <input type="file" id="editImageInput" name="image" class="d-none" accept="image/*" onchange="previewImage(event)">
          <div class="d-flex flex-column align-items-center justify-content-center">
            <img id="imagePreview" 
                 src="<%= professor.image && professor.image.url ? professor.image.url : '/images/default-professor.jpg' %>" 
                 alt="Current Photo" 
                 class="rounded-circle border shadow-sm mb-3" 
                 style="width: 100px; height: 100px; object-fit: cover;"
                 onerror="this.src='/images/default-professor.jpg'">
            <span class="fw-semibold text-primary small d-block">Click to select a new photo</span>
            <small class="text-muted">Leave empty to keep existing photo</small>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-3 pt-3 border-top">
        <a href="/professors/<%= professor._id %>" class="btn btn-outline-modern btn-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-primary-modern btn-pill px-5 flex-grow-1">
          <i class="bi bi-check-circle-fill me-1"></i> Update Changes
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewImage(event) {
    if (event.target.files && event.target.files[0]) {
      const output = document.getElementById('imagePreview');
      output.src = URL.createObjectURL(event.target.files[0]);
    }
  }
</script>
