<% layout('layouts/boilerplate') %>

<div class="container-xl py-5">
  <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5 mx-auto text-center bg-white" style="max-width: 540px;">
    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex p-4 mb-3 mx-auto align-items-center justify-content-center" style="width: 80px; height: 80px;">
      <i class="bi bi-exclamation-circle-fill fs-1"></i>
    </div>

    <h2 class="fw-bold text-dark mb-2">Something went wrong</h2>
    <p class="text-secondary mb-4">
      <%= (typeof err !== 'undefined' && err && err.message) ? err.message : "An unexpected error occurred while processing your request." %>
    </p>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <a href="/professors" class="btn btn-primary-modern btn-pill px-4 py-2">
        <i class="bi bi-grid me-1"></i> Faculty Directory
      </a>
      <a href="/" class="btn btn-outline-modern btn-pill px-4 py-2">
        <i class="bi bi-house me-1"></i> Return Home
      </a>
    </div>
  </div>
</div>
