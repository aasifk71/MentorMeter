<% layout('layouts/boilerplate') %>

<div class="container-xl py-4 py-lg-5">
  <!-- Directory Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="display-6 fw-bold mb-0">Faculty Directory</h1>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold" id="profCountBadge">
          <%= professors.length %> Professors
        </span>
      </div>
      <p class="text-muted mb-0">Browse and compare student evaluations across departments.</p>
    </div>

    <!-- Quick search input inside directory -->
    <div class="d-flex align-items-center gap-2" style="max-width: 320px; width: 100%;">
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0 rounded-start-pill text-muted ps-3">
          <i class="bi bi-search"></i>
        </span>
        <input 
          type="text" 
          id="clientSearchInput" 
          class="form-control border-start-0 rounded-end-pill py-2 shadow-none" 
          placeholder="Filter on this page..."
          value="<%= typeof query !== 'undefined' ? query : '' %>"
        >
      </div>
    </div>
  </div>

  <!-- Department Filter Chips Bar -->
  <% 
    const departments = [...new Set(professors.map(p => p.department).filter(Boolean))];
  %>
  <div class="mb-4">
    <div class="filter-chip-bar py-1" id="deptFilterChips">
      <button class="filter-chip active" data-filter="all">
        All Departments <span class="badge bg-light text-dark ms-1"><%= professors.length %></span>
      </button>
      <% departments.forEach(dep => { 
        const count = professors.filter(p => p.department === dep).length;
      %>
        <button class="filter-chip" data-filter="<%= dep %>">
          <%= dep %> <span class="badge bg-light text-dark ms-1"><%= count %></span>
        </button>
      <% }) %>
    </div>
  </div>

  <!-- Sorting & Active Filter Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <small class="text-muted" id="filterStatusText">Showing all professors</small>
    
    <div class="d-flex align-items-center gap-2">
      <label for="sortSelect" class="small text-muted fw-semibold text-nowrap d-none d-sm-inline">Sort by:</label>
      <select class="form-select form-select-sm rounded-pill px-3 py-1 border shadow-none" id="sortSelect" style="width: auto;">
        <option value="highest" selected>Highest Rated</option>
        <option value="lowest">Lowest Rated</option>
        <option value="alphabetical">Name (A-Z)</option>
        <option value="reviews">Most Reviews</option>
      </select>
    </div>
  </div>

  <!-- Professor Cards Grid -->
  <%
    // Sort professors initially by highest average rating
    professors.sort((a, b) => (b.averageRating || 0) - (a.averageRating || 0));
  %>

  <% if (professors.length > 0) { %>
    <div class="row g-4" id="professorGrid">
      <% professors.forEach(prof => { 
        const rating = prof.averageRating ? prof.averageRating.toFixed(2) : 'N/A';
        const ratingNum = prof.averageRating || 0;
        const reviewCount = prof.reviews ? prof.reviews.length : 0;
        let ratingClass = 'medium';
        if (ratingNum >= 4.0) ratingClass = 'high';
      %>
        <div class="col-12 col-sm-6 col-lg-4 professor-card-item" 
             data-name="<%= prof.name.toLowerCase() %>" 
             data-department="<%= (prof.department || '').toLowerCase() %>"
             data-rating="<%= ratingNum %>"
             data-reviews="<%= reviewCount %>">
          <div class="prof-grid-card">
            <!-- Top Avatar & Rating -->
            <div class="prof-avatar-wrapper">
              <img 
                src="<%= prof.image && prof.image.url ? prof.image.url : '/images/default-professor.jpg' %>" 
                alt="<%= prof.name %>" 
                class="prof-avatar-img"
                onerror="this.src='/images/default-professor.jpg'"
              >
            </div>

            <!-- Info -->
            <div class="text-center mb-3 flex-grow-1">
              <h5 class="fw-bold text-dark mb-1 text-truncate" title="<%= prof.name %>">
                <%= prof.name %>
              </h5>
              <div class="mb-2">
                <span class="dept-badge text-truncate" style="max-width: 220px;" title="<%= prof.department %>">
                  <i class="bi bi-building me-1"></i> <%= prof.department || 'General' %>
                </span>
              </div>
              <small class="text-muted d-block mb-3">
                <i class="bi bi-mortarboard me-1"></i> <%= prof.university || 'Delhi Technological University' %>
              </small>

              <!-- Rating Badge -->
              <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                <span class="rating-badge-pill <%= ratingClass %>">
                  <i class="bi bi-star-fill text-warning"></i>
                  <span><%= rating %></span>
                </span>
                <small class="text-muted">
                  (<%= reviewCount %> <%= reviewCount === 1 ? 'review' : 'reviews' %>)
                </small>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <a href="/professors/<%= prof._id %>" class="btn btn-outline-modern w-100 btn-pill">
              View Profile & Reviews <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Empty State for JS Filters -->
    <div id="noMatchMessage" class="text-center py-5 d-none">
      <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
        <i class="bi bi-search fs-1"></i>
      </div>
      <h4 class="fw-bold text-dark">No matching professors found</h4>
      <p class="text-muted small mb-3">Try adjusting your search keyword or department filter.</p>
      <button class="btn btn-outline-modern btn-pill px-4" id="resetFiltersBtn">
        Reset All Filters
      </button>
    </div>

  <% } else { %>
    <!-- Complete Empty State -->
    <div class="text-center py-5 bg-white border rounded-4 shadow-sm p-5">
      <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
        <i class="bi bi-people fs-1"></i>
      </div>
      <h4 class="fw-bold text-dark">No Faculty Profiles Yet</h4>
      <p class="text-muted mb-4">Be the first to request or add a professor to start the evaluation community.</p>
      <% if (currentUser && currentUser.isAdmin) { %>
        <a href="/professors/new" class="btn btn-primary-modern btn-pill px-4">
          + Add First Professor
        </a>
      <% } else { %>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSe0xA8IjPMI1prjbXtJGj6nFVsuQ8FQFImkJCQhpssxd8dYvw/viewform?usp=dialog" target="_blank" class="btn btn-outline-modern btn-pill px-4">
          Request a Professor
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<!-- Interactive Client-side Filter & Sort Script -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const chips = document.querySelectorAll(".filter-chip");
  const searchInput = document.getElementById("clientSearchInput");
  const sortSelect = document.getElementById("sortSelect");
  const grid = document.getElementById("professorGrid");
  const noMatchMsg = document.getElementById("noMatchMessage");
  const countBadge = document.getElementById("profCountBadge");
  const filterStatusText = document.getElementById("filterStatusText");
  const resetBtn = document.getElementById("resetFiltersBtn");

  if (!grid) return;

  let currentDept = "all";
  let currentQuery = (searchInput?.value || "").toLowerCase().trim();

  function applyFiltersAndSort() {
    const cards = Array.from(grid.querySelectorAll(".professor-card-item"));
    let visibleCount = 0;

    cards.forEach(card => {
      const name = card.getAttribute("data-name") || "";
      const dept = card.getAttribute("data-department") || "";
      const matchDept = (currentDept === "all" || dept === currentDept.toLowerCase());
      const matchQuery = (!currentQuery || name.includes(currentQuery) || dept.includes(currentQuery));

      if (matchDept && matchQuery) {
        card.style.display = "";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    // Handle empty state
    if (visibleCount === 0) {
      noMatchMsg?.classList.remove("d-none");
      grid.classList.add("d-none");
    } else {
      noMatchMsg?.classList.add("d-none");
      grid.classList.remove("d-none");
    }

    // Update count badge & text
    if (countBadge) countBadge.textContent = `${visibleCount} Professors`;
    if (filterStatusText) {
      filterStatusText.textContent = `Showing ${visibleCount} professor${visibleCount === 1 ? '' : 's'}${currentDept !== 'all' ? ` in ${currentDept}` : ''}`;
    }

    // Sort visible cards
    const sortMode = sortSelect?.value || "highest";
    cards.sort((a, b) => {
      const ratingA = parseFloat(a.dataset.rating) || 0;
      const ratingB = parseFloat(b.dataset.rating) || 0;
      const reviewsA = parseInt(a.dataset.reviews) || 0;
      const reviewsB = parseInt(b.dataset.reviews) || 0;
      const nameA = (a.dataset.name || "");
      const nameB = (b.dataset.name || "");

      if (sortMode === "highest") return ratingB - ratingA;
      if (sortMode === "lowest") return ratingA - ratingB;
      if (sortMode === "reviews") return reviewsB - reviewsA;
      if (sortMode === "alphabetical") return nameA.localeCompare(nameB);
      return 0;
    });

    cards.forEach(card => grid.appendChild(card));
  }

  // Department Chip Clicks
  chips.forEach(chip => {
    chip.addEventListener("click", () => {
      chips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      currentDept = chip.getAttribute("data-filter") || "all";
      applyFiltersAndSort();
    });
  });

  // Search input live filtering
  searchInput?.addEventListener("input", (e) => {
    currentQuery = e.target.value.toLowerCase().trim();
    applyFiltersAndSort();
  });

  // Sort dropdown change
  sortSelect?.addEventListener("change", () => {
    applyFiltersAndSort();
  });

  // Reset filters button
  resetBtn?.addEventListener("click", () => {
    currentDept = "all";
    currentQuery = "";
    if (searchInput) searchInput.value = "";
    chips.forEach(c => c.classList.remove("active"));
    chips[0]?.classList.add("active");
    if (sortSelect) sortSelect.value = "highest";
    applyFiltersAndSort();
  });

  // Initial pass if query was present in URL
  if (currentQuery) {
    applyFiltersAndSort();
  }
});
</script>
