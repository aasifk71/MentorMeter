<% layout('layouts/boilerplate') %>

<div class="container-xl py-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/professors" class="text-decoration-none">Faculty</a></li>
      <li class="breadcrumb-item active" aria-current="page">Add New Professor</li>
    </ol>
  </nav>

  <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5 mx-auto bg-white" style="max-width: 720px;">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
      <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
        <i class="bi bi-person-plus-fill fs-5"></i>
      </div>
      <div>
        <h3 class="fw-bold text-dark mb-0">Add New Faculty Member</h3>
        <small class="text-muted">Create a new professor profile for student reviews and evaluations</small>
      </div>
    </div>

    <form action="/professors" method="POST" enctype="multipart/form-data">
      <!-- Professor Name -->
      <div class="mb-4">
        <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
          <input type="text" id="name" name="professor[name]" class="form-control border-start-0 ps-0" placeholder="e.g. Prof. Rajesh Sharma" required>
        </div>
      </div>

      <!-- Department -->
      <div class="mb-4">
        <label for="department" class="form-label">Department <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-building"></i></span>
          <input type="text" id="department" name="professor[department]" class="form-control border-start-0 ps-0" placeholder="e.g. Computer Science & Engineering" required>
        </div>
      </div>

      <!-- University -->
      <div class="mb-4">
        <label for="university" class="form-label">University / Institution</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
          <input type="text" id="university" class="form-control border-start-0 ps-0 bg-light" value="Delhi Technological University" disabled>
        </div>
      </div>

      <!-- Description / Biography -->
      <div class="mb-4">
        <label for="description" class="form-label">Faculty Bio & Research Areas (Optional)</label>
        <textarea id="description" name="professor[description]" class="form-control" rows="4"
          placeholder="Brief description of research domains, subjects taught, or notable background..."></textarea>
      </div>

      <!-- Profile Image Upload with Live Preview -->
      <div class="mb-4">
        <label class="form-label">Profile Photo (Optional)</label>
        <div class="upload-dropzone" onclick="document.getElementById('imageInput').click()">
          <input type="file" id="imageInput" name="image" class="d-none" accept="image/*" onchange="previewImage(event)">
          <div class="d-flex flex-column align-items-center justify-content-center">
            <img id="imagePreview" src="/images/default-professor.jpg" alt="Preview" class="rounded-circle border shadow-sm mb-3" style="width: 100px; height: 100px; object-fit: cover;">
            <span class="fw-semibold text-primary small d-block">Click to upload photo</span>
            <small class="text-muted">PNG, JPG, WEBP up to 5MB</small>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-3 pt-3 border-top">
        <a href="/professors" class="btn btn-outline-modern btn-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-primary-modern btn-pill px-5 flex-grow-1">
          <i class="bi bi-check-circle-fill me-1"></i> Save Professor
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewImage(event) {
    if (event.target.files && event.target.files[0]) {
      const output = document.getElementById('imagePreview');
      output.src = URL.createObjectURL(event.target.files[0]);
    }
  }
</script>
