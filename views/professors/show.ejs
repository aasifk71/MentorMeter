<% layout('layouts/boilerplate') %>

<div class="container-xl py-4 py-lg-5">

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/professors" class="text-decoration-none">Faculty</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= professor.name %></li>
    </ol>
  </nav>

  <!-- 1. Faculty Hero Profile Card -->
  <div class="prof-hero-card fade-in">
    <div class="d-flex flex-column flex-lg-row align-items-center align-items-lg-start gap-4">
      
      <!-- Profile Picture -->
      <div class="position-relative">
        <img 
          src="<%= professor.image && professor.image.url ? professor.image.url : '/images/default-professor.jpg' %>"
          alt="<%= professor.name %>"
          class="prof-hero-avatar"
          onerror="this.src='/images/default-professor.jpg'"
        >
      </div>

      <!-- Info details -->
      <div class="flex-grow-1 text-center text-lg-start">
        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-2 mb-2">
          <h1 class="display-6 fw-bold text-dark mb-0"><%= professor.name %></h1>
          <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-semibold">
            <i class="bi bi-patch-check-fill me-1"></i> Verified Faculty
          </span>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-2 mb-3">
          <span class="dept-badge">
            <i class="bi bi-building me-1 text-primary"></i> <%= professor.department || 'General Department' %>
          </span>
          <span class="dept-badge">
            <i class="bi bi-mortarboard me-1 text-info"></i> <%= professor.university || 'Delhi Technological University' %>
          </span>
        </div>

        <% if (professor.description && professor.description.trim() !== "") { %>
          <p class="text-secondary mb-3" style="max-width: 680px; line-height: 1.6;">
            <%= professor.description %>
          </p>
        <% } else { %>
          <p class="text-muted fst-italic mb-3">No biography or additional notes provided.</p>
        <% } %>

        <!-- Admin Actions -->
        <% if (currentUser && currentUser.isAdmin) { %>
          <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start pt-2">
            <a href="/professors/<%= professor._id %>/edit" class="btn btn-outline-modern btn-pill btn-sm px-3">
              <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </a>
            <form 
              action="/professors/<%= professor._id %>?_method=DELETE"
              method="POST"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this professor? This action cannot be undone.')">
              <button class="btn btn-outline-danger btn-pill btn-sm px-3">
                <i class="bi bi-trash me-1"></i> Delete
              </button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Rating Display Score Box -->
      <div class="rating-display-box ms-lg-auto">
        <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
          <span class="rating-big-score">
            <%= professor.averageRating ? professor.averageRating.toFixed(1) : "N/A" %>
          </span>
          <% if (professor.averageRating) { %>
            <span class="fs-4 text-warning">★</span>
          <% } %>
        </div>
        
        <div class="small fw-bold text-dark mb-1">
          <% if (!professor.averageRating) { %>
            Awaiting Reviews
          <% } else if (professor.averageRating >= 4.5) { %>
            Outstanding Mentor
          <% } else if (professor.averageRating >= 3.8) { %>
            Highly Recommended
          <% } else if (professor.averageRating >= 3.0) { %>
            Good Evaluation
          <% } else { %>
            Needs Improvement
          <% } %>
        </div>

        <small class="text-muted d-block">
          Based on <%= professor.reviews ? professor.reviews.length : 0 %> student <%= professor.reviews && professor.reviews.length === 1 ? 'rating' : 'ratings' %>
        </small>
      </div>

    </div>
  </div>

  <!-- 2. Performance Metrics Grid -->
  <div class="mb-5">
    <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
      <i class="bi bi-bar-chart-line-fill text-primary"></i> Performance Overview
    </h4>

    <div class="row g-4">
      <!-- Attendance Strictness -->
      <div class="col-md-4">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <h6 class="fw-bold text-dark mb-0">Attendance Policy</h6>
            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold rounded-pill">
              <%= attendanceAvg.toFixed(1) %> / 5.0
            </span>
          </div>
          <small class="text-muted">Strictness & regular attendance tracking</small>
          
          <div class="metric-progress">
            <div class="progress-bar bg-warning progress-bar-modern" style="width: <%= (attendanceAvg / 5) * 100 %>%"></div>
          </div>
          
          <div class="d-flex justify-content-between small text-muted mt-2">
            <span>Flexible</span>
            <span>Mandatory 75%+</span>
          </div>
        </div>
      </div>

      <!-- Grading Fairness -->
      <div class="col-md-4">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <h6 class="fw-bold text-dark mb-0">Grading Fairness</h6>
            <span class="badge bg-info-subtle text-info-emphasis fw-bold rounded-pill">
              <%= gradingAvg.toFixed(1) %> / 5.0
            </span>
          </div>
          <small class="text-muted">Exam evaluation & rubric transparency</small>
          
          <div class="metric-progress">
            <div class="progress-bar bg-info progress-bar-modern" style="width: <%= (gradingAvg / 5) * 100 %>%"></div>
          </div>

          <div class="d-flex justify-content-between small text-muted mt-2">
            <span>Tough Marker</span>
            <span>Fair & Transparent</span>
          </div>
        </div>
      </div>

      <!-- Teaching & Material Quality -->
      <div class="col-md-4">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <h6 class="fw-bold text-dark mb-0">Teaching & Resources</h6>
            <span class="badge bg-success-subtle text-success-emphasis fw-bold rounded-pill">
              <%= fypAvg.toFixed(1) %> / 5.0
            </span>
          </div>
          <small class="text-muted">Lecture clarity, materials & FYP mentorship</small>
          
          <div class="metric-progress">
            <div class="progress-bar bg-success progress-bar-modern" style="width: <%= (fypAvg / 5) * 100 %>%"></div>
          </div>

          <div class="d-flex justify-content-between small text-muted mt-2">
            <span>Basic Notes</span>
            <span>Top-Tier Guidance</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Student Reviews Section -->
  <div class="reviews-container">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-3 border-bottom">
      <div>
        <h4 class="fw-bold text-dark mb-1">Student Evaluations</h4>
        <small class="text-muted"><%= professor.reviews ? professor.reviews.length : 0 %> verified experiences shared</small>
      </div>

      <!-- Sorting Pill Dropdown -->
      <div class="dropdown">
        <button class="btn btn-outline-modern btn-pill btn-sm px-3 dropdown-toggle" type="button" id="sortDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-filter me-1 text-primary"></i> <span id="sortLabel">Newest First</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2" aria-labelledby="sortDropdownBtn">
          <li><a class="dropdown-item sort-option rounded-3 py-2" href="javascript:void(0)" data-sort="newest">Newest First</a></li>
          <li><a class="dropdown-item sort-option rounded-3 py-2" href="javascript:void(0)" data-sort="oldest">Oldest First</a></li>
          <li><a class="dropdown-item sort-option rounded-3 py-2" href="javascript:void(0)" data-sort="best">Top Rated</a></li>
          <li><a class="dropdown-item sort-option rounded-3 py-2" href="javascript:void(0)" data-sort="worst">Lowest Rated</a></li>
        </ul>
      </div>
    </div>

    <!-- Reviews List -->
    <% if (professor.reviews && professor.reviews.length > 0) { %>
      <div id="reviewsList" class="reviews-scrollable <%= professor.reviews.length > 4 ? 'force-scroll' : '' %>">
        <% professor.reviews.forEach(review => {
          const individualAvg = ((review.attendance + review.grading + review.fypSupport) / 3);
          const individualAvgFixed = individualAvg.toFixed(1);
          const stars = Math.round(individualAvg);
          const createdIso = review.createdAt ? new Date(review.createdAt).toISOString() : '';
          const authorName = (review.author && review.author.username) ? review.author.username : 'Anonymous Student';
          const authorInitial = authorName.charAt(0).toUpperCase();
        %>
          <div class="review-item-modern review-item" data-rating="<%= individualAvg %>" data-date="<%= createdIso %>">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
              <div class="d-flex align-items-center gap-3">
                <div class="review-author-avatar">
                  <%= authorInitial %>
                </div>
                <div>
                  <div class="d-flex align-items-center gap-2">
                    <strong class="text-dark"><%= authorName %></strong>
                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">Verified Student</span>
                  </div>
                  <small class="text-muted">
                    <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Recently' %>
                  </small>
                </div>
              </div>

              <!-- Rating Score -->
              <span class="rating-badge-pill high">
                <i class="bi bi-star-fill text-warning"></i> <%= individualAvgFixed %> / 5.0
              </span>
            </div>

            <!-- Review Body -->
            <p class="text-dark my-3" style="line-height: 1.6; font-size: 0.96rem;">
              <%= review.body %>
            </p>

            <!-- Metric Tags -->
            <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
              <span class="badge bg-light text-secondary border">
                Attendance: <strong><%= review.attendance %>/5</strong>
              </span>
              <span class="badge bg-light text-secondary border">
                Grading: <strong><%= review.grading %>/5</strong>
              </span>
              <span class="badge bg-light text-secondary border">
                Teaching: <strong><%= review.fypSupport %>/5</strong>
              </span>

              <!-- Author / Admin Actions -->
              <% if (currentUser && review.author && (review.author._id.equals(currentUser._id) || currentUser.isAdmin)) { %>
                <div class="ms-auto d-flex gap-2">
                  <a href="/professors/<%= professor._id %>/reviews/<%= review._id %>/edit" class="btn btn-sm btn-outline-primary btn-pill py-1 px-3">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/professors/<%= professor._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                    <button class="btn btn-sm btn-outline-danger btn-pill py-1 px-3">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <div class="rounded-circle bg-light d-inline-flex p-3 mb-3 text-muted">
          <i class="bi bi-chat-square-quote fs-2"></i>
        </div>
        <h5 class="fw-bold text-dark">No reviews yet</h5>
        <p class="text-muted small">Be the first student to review <%= professor.name %>!</p>
      </div>
    <% } %>
  </div>

  <!-- 4. Review Submission Form -->
  <% if (currentUser) { %>
    <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5 mb-5 bg-white">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
          <i class="bi bi-pencil-fill"></i>
        </div>
        <h4 class="fw-bold mb-0 text-dark">Write Your Review</h4>
      </div>

      <div class="p-3 bg-light rounded-3 border-start border-4 border-primary mb-4">
        <div class="d-flex align-items-center gap-2 text-primary fw-bold small mb-1">
          <i class="bi bi-shield-check"></i> Community Review Guidelines
        </div>
        <p class="small text-muted mb-0">
          Focus on teaching methodology, evaluation fairness, syllabus coverage, and learning outcomes. Please remain respectful, constructive, and avoid personal remarks.
        </p>
      </div>

      <form action="/professors/<%= professor._id %>/reviews" method="POST">
        <!-- Review Body -->
        <div class="mb-4">
          <label class="form-label fw-bold">Your Detailed Feedback</label>
          <textarea 
            name="review[body]" 
            rows="4" 
            class="form-control" 
            placeholder="Describe your learning experience, lecture engagement, grading expectations, and advice for future students..." 
            required
          ></textarea>
        </div>

        <!-- Metric Selectors -->
        <div class="row g-4 mb-4">
          <!-- Attendance -->
          <div class="col-md-4">
            <label class="form-label fw-bold d-flex justify-content-between">
              <span>Attendance</span>
              <span class="text-muted small">Strictness</span>
            </label>
            <select name="review[attendance]" class="form-select">
              <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Mandatory / Strict)</option>
              <option value="4">⭐⭐⭐⭐ (4 - Regular)</option>
              <option value="3">⭐⭐⭐ (3 - Moderate)</option>
              <option value="2">⭐⭐ (2 - Relaxed)</option>
              <option value="1">⭐ (1 - Very Lenient)</option>
            </select>
          </div>

          <!-- Grading Fairness -->
          <div class="col-md-4">
            <label class="form-label fw-bold d-flex justify-content-between">
              <span>Grading Fairness</span>
              <span class="text-muted small">Transparency</span>
            </label>
            <select name="review[grading]" class="form-select">
              <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Extremely Fair & Clear)</option>
              <option value="4">⭐⭐⭐⭐ (4 - Generally Fair)</option>
              <option value="3">⭐⭐⭐ (3 - Average / Standard)</option>
              <option value="2">⭐⭐ (2 - Strict Grading)</option>
              <option value="1">⭐ (1 - Unpredictable / Harsh)</option>
            </select>
          </div>

          <!-- Teaching / FYP -->
          <div class="col-md-4">
            <label class="form-label fw-bold d-flex justify-content-between">
              <span>Teaching & Guidance</span>
              <span class="text-muted small">Material Quality</span>
            </label>
            <select name="review[fypSupport]" class="form-select">
              <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Outstanding Guidance)</option>
              <option value="4">⭐⭐⭐⭐ (4 - Very Helpful)</option>
              <option value="3">⭐⭐⭐ (3 - Good Study Materials)</option>
              <option value="2">⭐⭐ (2 - Minimal Support)</option>
              <option value="1">⭐ (1 - Inadequate Support)</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-gradient-modern btn-pill px-4 py-2">
          <i class="bi bi-send-fill me-1"></i> Submit Authentic Review
        </button>
      </form>
    </div>
  <% } else { %>
    <!-- Login to review CTA -->
    <div class="card shadow-sm border-0 rounded-4 p-4 text-center mb-5 bg-white">
      <i class="bi bi-lock-fill text-muted fs-2 mb-2"></i>
      <h5 class="fw-bold text-dark">Have you taken a course with <%= professor.name %>?</h5>
      <p class="text-muted small mb-3">Sign in with your DTU student credentials to leave a constructive review.</p>
      <div>
        <a href="/login" class="btn btn-primary-modern btn-pill px-4 py-2">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Review
        </a>
      </div>
    </div>
  <% } %>

  <!-- 5. Legal & Community Disclaimer -->
  <div class="card border rounded-4 p-4 bg-light shadow-none">
    <div class="d-flex align-items-start gap-3">
      <div class="text-secondary fs-4 mt-1">
        <i class="bi bi-shield-exclamation"></i>
      </div>
      <div>
        <h6 class="fw-bold text-dark mb-1">Platform Community & Content Disclaimer</h6>
        <p class="small text-muted mb-2">
          Evaluations and ratings published on MentorMeter reflect the individual, subjective opinions of students and are not endorsed by the platform administrators or Delhi Technological University.
        </p>
        <p class="small text-muted mb-0">
          We maintain strict moderation standards: any abusive, malicious, or defamatory commentary will be promptly reviewed and removed.
        </p>
      </div>
    </div>
  </div>

</div>

<!-- Reviews Sorting Script -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const listEl = document.getElementById('reviewsList');
  const sortBtn = document.getElementById('sortDropdownBtn');
  const sortLabelEl = document.getElementById('sortLabel');

  if (!listEl || !sortBtn) return;

  function getItems() {
    return Array.from(listEl.querySelectorAll('.review-item'));
  }

  const comparators = {
    newest: (a, b) => (new Date(b.dataset.date || 0)) - (new Date(a.dataset.date || 0)),
    oldest: (a, b) => (new Date(a.dataset.date || 0)) - (new Date(b.dataset.date || 0)),
    best: (a, b) => (parseFloat(b.dataset.rating) || 0) - (parseFloat(a.dataset.rating) || 0),
    worst: (a, b) => (parseFloat(a.dataset.rating) || 0) - (parseFloat(b.dataset.rating) || 0)
  };

  function sortAndRender(mode = 'newest') {
    const prevScroll = listEl.scrollTop;
    const arr = getItems();
    arr.sort(comparators[mode] || comparators.newest);

    const frag = document.createDocumentFragment();
    arr.forEach(node => frag.appendChild(node));
    listEl.innerHTML = '';
    listEl.appendChild(frag);

    setTimeout(() => { listEl.scrollTop = prevScroll; }, 0);
  }

  document.addEventListener('click', function (ev) {
    const opt = ev.target.closest('.sort-option');
    if (!opt) return;
    ev.preventDefault();
    const mode = opt.dataset.sort || 'newest';
    if (sortLabelEl) sortLabelEl.textContent = opt.textContent.trim();
    sortAndRender(mode);
    try { bootstrap.Dropdown.getOrCreateInstance(sortBtn).hide(); } catch (e) {}
  });
});
</script>
