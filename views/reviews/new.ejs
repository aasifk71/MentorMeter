<% layout('layouts/boilerplate') %>

<div class="container-xl py-5">
  <div class="card shadow-sm border-0 rounded-4 p-4 p-lg-5 mx-auto bg-white" style="max-width: 720px;">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
      <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
        <i class="bi bi-star-fill fs-5"></i>
      </div>
      <div>
        <h3 class="fw-bold text-dark mb-0">Review for <%= professor.name %></h3>
        <small class="text-muted"><%= professor.department %> &bull; Delhi Technological University</small>
      </div>
    </div>

    <form action="/professors/<%= professor._id %>/reviews" method="POST">
      <!-- Review Body -->
      <div class="mb-4">
        <label class="form-label fw-bold">Detailed Feedback <span class="text-danger">*</span></label>
        <textarea
          name="review[body]"
          rows="4"
          class="form-control"
          placeholder="Describe your classroom experience, interaction, and suggestions..."
          required
        ></textarea>
      </div>

      <!-- Metrics -->
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <label class="form-label fw-bold">Attendance Strictness</label>
          <select name="review[attendance]" class="form-select">
            <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Strict)</option>
            <option value="4">⭐⭐⭐⭐ (4 - Regular)</option>
            <option value="3">⭐⭐⭐ (3 - Moderate)</option>
            <option value="2">⭐⭐ (2 - Relaxed)</option>
            <option value="1">⭐ (1 - Lenient)</option>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label fw-bold">Grading Fairness</label>
          <select name="review[grading]" class="form-select">
            <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Very Fair)</option>
            <option value="4">⭐⭐⭐⭐ (4 - Generally Fair)</option>
            <option value="3">⭐⭐⭐ (3 - Standard)</option>
            <option value="2">⭐⭐ (2 - Strict)</option>
            <option value="1">⭐ (1 - Harsh)</option>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label fw-bold">Teaching & Material</label>
          <select name="review[fypSupport]" class="form-select">
            <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Outstanding)</option>
            <option value="4">⭐⭐⭐⭐ (4 - Helpful)</option>
            <option value="3">⭐⭐⭐ (3 - Average)</option>
            <option value="2">⭐⭐ (2 - Minimal)</option>
            <option value="1">⭐ (1 - Inadequate)</option>
          </select>
        </div>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-3 pt-3 border-top">
        <a href="/professors/<%= professor._id %>" class="btn btn-outline-modern btn-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-primary-modern btn-pill px-5 flex-grow-1">
          <i class="bi bi-send-fill me-1"></i> Submit Evaluation
        </button>
      </div>
    </form>
  </div>
</div>
