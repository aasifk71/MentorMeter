<% layout('layouts/boilerplate') %>

<div class="container-xl py-5">
  <div class="auth-card fade-in">
    <!-- Brand Icon & Header -->
    <div class="text-center mb-4">
      <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.5rem;">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <h2 class="fw-bold text-dark mb-1">Create Account</h2>
      <p class="text-muted small">Join the student community to evaluate courses & professors</p>
    </div>

    <!-- Primary OAuth Signup -->
    <div class="d-flex flex-column gap-3 mb-4">
      <a href="/auth/google" class="btn btn-outline-modern w-100 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm">
        <img src="https://www.svgrepo.com/show/355037/google.svg" alt="Google" width="20" height="20">
        <span>Sign up with Google</span>
      </a>
    </div>

    <!-- Security & Trust Note -->
    <div class="p-3 bg-light rounded-3 text-center mb-4 border">
      <div class="d-flex align-items-center justify-content-center gap-2 text-dark small fw-semibold mb-1">
        <i class="bi bi-shield-check text-success fs-5"></i> Fast & 100% Secure
      </div>
      <small class="text-muted d-block" style="font-size: 0.78rem;">
        No passwords to remember. Instant access with your university Google account.
      </small>
    </div>

    <!-- Login Switch Link -->
    <div class="text-center pt-2 border-top">
      <p class="text-muted small mb-0">
        Already registered? 
        <a href="/login" class="fw-bold text-primary text-decoration-none ms-1">Log in here</a>
      </p>
    </div>
  </div>
</div>
